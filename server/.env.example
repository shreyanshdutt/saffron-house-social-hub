# Copy to server/.env and fill in. server/.env is gitignored and must never be
# committed — a secret that has ever been committed is compromised and must be
# rotated, not merely deleted (CONVENTIONS.md §10).
#
# KEYS ONLY IN THIS FILE. NO VALUES.
#
# This file describes the FULL credential surface of the product as demoed —
# Google Maps/Places, Google Business Profile, Instagram, WhatsApp, X and
# YouTube — not the subset that is wired up. Every group below is marked with
# whether it is used, and today the honest answer for all six is NO: this build
# makes no external API call of any kind, and nothing outside the Service group
# is read by `config.js`. The keys are listed so the shape of what will be
# needed is visible before anyone goes looking for it, and so a reader can tell
# "not built yet" from "built and undocumented".
#
# Env var names are OURS; the field names they carry are the platforms'. Where
# a name maps to a documented field, the comment says which — a plausible
# variable name that turns out to be wrong is worse than an obviously generic
# one, because it gets trusted.

# --- Service ---------------------------------------------------------------
PORT=
DATABASE_PATH=

# How many days non-place_id Google Places content is retained before purge.
# Google Maps Platform Service Specific Terms §14.3 caps this at 30. Leave
# blank to use the built-in default; a value above 30 is refused at boot.
PLACES_RETENTION_DAYS=

# --- Google Maps / Places (NOT USED YET) ------------------------------------
# Nearby Search and Place Details, for the Establishments scan. Blocked on the
# §10 gate as well as on this key.
GOOGLE_MAPS_API_KEY=

# --- Google Business Profile (NOT USED YET) ---------------------------------
# OUR OWN listing: reviews, replies, Q&A and the metrics behind `saf-self`.
# Not Places — a different API over different data, and §14.3 does not reach
# it because the listing is the restaurant's own.
#
# Standard Google OAuth 2.0 installed-app credentials. The scope required by
# most methods is https://www.googleapis.com/auth/business.manage.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
# Identifiers, NOT full resource names: the API addresses these as
# `accounts/{account_id}` and `accounts/{account_id}/locations/{location_id}`.
# Store the bare ids here and let the caller build the path.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Meta / Instagram Graph (NOT USED YET) ----------------------------------
# Business Discovery for competitors, and our own media and insights.
IG_APP_ID=
IG_APP_SECRET=
IG_LONG_LIVED_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Meta / WhatsApp Cloud API (NOT USED YET) -------------------------------
# The Inbox. `phone_number_id` and the WhatsApp Business Account ID are the two
# ids Meta returns in every webhook payload's `metadata`; the access token is
# the one generated under App Dashboard > WhatsApp > API Setup and is sent as
# `Authorization: Bearer <token>`.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# The value WE choose and Meta echoes back as `hub.verify_token` when it
# verifies the webhook subscription. It is a shared secret, not a Meta-issued
# credential, and it is the only key in this file we invent rather than receive.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- X / API (NOT USED YET) -------------------------------------------------
# Reading a competitor's public posts. Costed, not free: on 6 Feb 2026 X made
# pay-per-use the default and there is no free tier for new developers, so
# credits are bought up front in the developer console and drawn down per call.
# Budget before wiring — DATA-SOURCES.md already records that X reading needs a
# paid tier, which is why an X handle does not count toward availability.
#
# "API Key and Secret" are X's names for the consumer key/secret pair.
X_API_KEY=
X_API_KEY_SECRET=
# App-only OAuth 2.0. This is the one a read-only integration actually needs;
# it can be generated from the key/secret pair above.
X_BEARER_TOKEN=
# OAuth 2.0 confidential-client credentials, needed only for user-context calls
# (posting, or reading anything private). Not required to read public posts.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# --- YouTube (NOT USED YET) -------------------------------------------------
# TWO DIFFERENT THINGS, deliberately kept apart:
#
# 1. YouTube Data API v3 — PUBLIC data (a channel's public videos, counts).
#    An API key is enough; no user consent, no OAuth, and it can read channels
#    that are not ours.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
#
# 2. YouTube Analytics API — OUR OWN channel's analytics (views, watch time,
#    subscribers gained). An API key CANNOT do this: it requires OAuth 2.0 and
#    channel ownership, addressed as `channel==MINE` for the authorised user.
#    Same distinction as Places vs Business Profile above — public snapshot
#    versus owner's own data.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
